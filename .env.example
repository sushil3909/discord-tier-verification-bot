# Copy this file to ".env" and fill in the values. Never commit .env.

# Bot token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Google Chat webhook for problems that need a person to act
GCHAT_WEBHOOK_URL=

# Optional: Google Sheets mirror. Paste the sheet URL or just its ID.
GSHEET_ID=
GOOGLE_CREDS_FILE=service_account.json
JOURNEY_DB=client_journey.db

# Optional: curated Inner Circle list kept in a separate Google Sheet
INNER_CIRCLE_URL=
INNER_CIRCLE_TAB=Members
